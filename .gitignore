# ==============================================================================
# Git Ignore Rules for Real Human LoRA Dataset Pipeline Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Virtual Environments & Packages
# ------------------------------------------------------------------------------
venv/
.venv/
.venv*/
env/
ENV/
.step4_packages/
*.egg-info/
dist/
build/
wheels/
*.whl

# ------------------------------------------------------------------------------
# 2. Python Bytecode & Cache
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. User Configurations & Secrets (Keep example files tracked)
# ------------------------------------------------------------------------------
config/config.yaml
config/config.json
config/local_config.*
*.local.yaml
*.local.json
.env
.env.*
secrets/
private/

# Keep config templates tracked
!config/config.example.yaml
!config/config.schema.json

# ------------------------------------------------------------------------------
# 4. Input Media (Real Human Videos / Reference Faces)
# ------------------------------------------------------------------------------
input/original-mp4/*
!input/original-mp4/.gitkeep
!input/original-mp4/README.md

input/reference/*
!input/reference/.gitkeep
!input/reference/README.md

# ------------------------------------------------------------------------------
# 5. Intermediate Working Directories & Extracted Frames
# ------------------------------------------------------------------------------
work/frames_raw/*
!work/frames_raw/.gitkeep
!work/frames_raw/README.md

work/facegate_review/*
!work/facegate_review/.gitkeep
!work/facegate_review/README.md

work/facegate_face_crops/*
!work/facegate_face_crops/.gitkeep
!work/facegate_face_crops/README.md

work/identity_review/*
!work/identity_review/.gitkeep
!work/identity_review/README.md

work/candidates/*
!work/candidates/.gitkeep
!work/candidates/README.md

work/selected/*
!work/selected/.gitkeep
!work/selected/README.md

work/restored/*
!work/restored/.gitkeep
!work/restored/README.md

# ------------------------------------------------------------------------------
# 6. Final Outputs & Reports (Generated Datasets)
# ------------------------------------------------------------------------------
output/dataset_flux/*
!output/dataset_flux/.gitkeep
!output/dataset_flux/README.md

# Reports are tracked for Chappy collaboration; backup directories remain ignored.

# Common raw media types if placed accidentally in root
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v

# ------------------------------------------------------------------------------
# 7. Model Binaries & Weights (Keep README and place-holders tracked)
# ------------------------------------------------------------------------------
models/*.onnx
models/*.pth
models/*.pt
models/*.bin
models/*.safetensors
models/*.ckpt
!models/.gitkeep
!models/README.md

# HuggingFace & Torch Hub download caches
.cache/
torch_cache/
huggingface/

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
tmp/
.tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 9. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# STEP1 private normalized videos and provenance
work/videos/
work/manifests/

# Recovered STEP1 frames in a separate configured root
work/frames_step1/

# Preserved extraction generations (private images)
work/*_previous/

# Local isolated STEP3 dependencies
.step3_packages/

# Environment-specific diagnostic input declaration
config/step3_revision_a.local.json

# Backup directories are local only; never include in report/document commits.
**/bkup/
**/backup/
**/backups/

# Disposable private STEP3 review image copies (reports/CSV remain tracked).
/output/reports/passed/
/output/reports/borderline/
/output/reports/.step3-review-stage-*/

/output/reports/reject/

# Disposable BEST review copies; history/CSV stay trackable.
output/reports/step3_best_review/
output/reports/.step3_best_operation.lock
/output/reports/.step4_pose_operation.lock
/output/reports/.step5_dedup_operation.lock
/output/reports/.step5_stage_*/
/output/reports/.step6_identity_operation.lock
/output/reports/.step7_candidate_operation.lock

# Historical calibration inputs contain private source pixels and local metadata.
/input/canonical_sharpness*/

# Private media may also appear in report examples; keep text reports shareable.
/output/reports/**/*.png
/output/reports/**/*.jpg
/output/reports/**/*.jpeg
/output/reports/**/*.webp
/output/reports/**/*.gif
/output/reports/**/*.bmp
/output/reports/**/*.tif
/output/reports/**/*.tiff

# Additional configured intermediate image outputs; keep explanatory templates.
/work/pose_review/*
!/work/pose_review/.gitkeep
!/work/pose_review/README.md
/work/frames_deduplicated/*
!/work/frames_deduplicated/.gitkeep
!/work/frames_deduplicated/README.md

# Source code, Agent Rules, Knowledge, tests, documentation, configuration
# templates and non-media reports remain eligible for version control.

# STEP8 copies/staging are an interaction surface, never source or code assets.
/work/step8_review/
/work/.step8_stage_*/
/output/reports/.step8_folder_operation.lock
