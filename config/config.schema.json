      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "version"
            ],
            "properties": {
              "version": {
                "const": "step6_identity_v2"
              }
            }
          },
          "then": {
            "required": [
              "version",
              "backend",
              "model_name",
              "device",
              "identity_threshold",
              "min_reference_count",
              "max_reference_count",
              "limit",
              "report",
              "step5_summary",
              "output_csv",
              "summary",
              "markdown",
              "review_html",
              "reference_csv",
              "reference_summary",
              "reference_markdown",
              "reference_html"
            ],
            "properties": {
              "backend": {
                "const": "insightface"
              },
              "model_name": {
                "const": "buffalo_l"
              },
              "device": {
                "enum": [
                  "auto",
                  "cpu",
                  "cuda"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "base_thresholds"
                  ]
                },
                {
                  "required": [
                    "pose_modifiers"
                  ]
                },
                {
                  "required": [
                    "eval_all_eligible"
                  ]
                }
              ]
            }
          }
        }
      ]
